{
  "mcpServers": {
    "jira": {
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "https://sspataro.atlassian.net",
        "JIRA_USERNAME": "sspataro@gmail.com",
        "JIRA_API_TOKEN": "${JIRA_TOKEN_PERSONAL}"
      }
    },
    "ops": {
      "command": "go",
      "args": [
        "run",
        "./cmd/ops-mcp"
      ],
      "env": {
        "DATABASE_URL": "${OPS_DATABASE_URL}",
        "OPS_WORKER_ID": "manual:salvo",
        "OPS_TOKEN_KEY": "${OPS_TOKEN_KEY}",
        "SLACK_WEB_BRIDGE_URL": "http://192.168.50.130:8787",
        "SLACK_WEB_BRIDGE_TOKEN_FILE": "${HOME}/.config/switchboard/slack-bridge-token"
      }
    }
  }
}
