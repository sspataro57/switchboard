{
  "mcpServers": {
    "jira": {
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "https://sspataro.atlassian.net",
        "JIRA_USERNAME": "sspataro@gmail.com",
        "JIRA_API_TOKEN": "${JIRA_TOKEN_PERSONAL}"
      }
    },
    "ops": {
      "command": "go",
      "args": [
        "run",
        "./cmd/ops-mcp"
      ],
      "env": {
        "DATABASE_URL": "${OPS_DATABASE_URL}",
        "OPS_WORKER_ID": "manual:salvo",
        "OPS_TOKEN_KEY": "${OPS_TOKEN_KEY}"
      }
    }
  }
}
